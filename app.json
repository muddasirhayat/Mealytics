{
  "expo": {
    "name": "Mealytics",
    "slug": "Mealytics",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/logo.png",
    "scheme": "mealytics",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#E6EBF2",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#E6EBF2",
      "translucent": false
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#E6EBF2"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.muddasirhayat.mealytics",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/logo.png",
        "backgroundColor": "#5B5FEF",
        "monochromeImage": "./assets/brand/monochrome-icon.png"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.muddasirhayat.mealytics",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#E6EBF2",
          "dark": {
            "image": "./assets/brand/logo.png",
            "backgroundColor": "#252A37"
          }
        }
      ],
      "expo-status-bar",
      "expo-font",
      "expo-system-ui",
      "expo-audio",
      "expo-image",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "usesCleartextTraffic": false,
            "newArchEnabled": true
          },
          "ios": {
            "newArchEnabled": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8a346e5b-6d0c-40bf-a05c-7d4dca10799e"
      }
    }
  }
}
